      { "id": "ep-t2", "externalId": "x-t2", "sessionId": "s1", "seq": 1, "role": "user", "text": "first instant OF the Tokyo day", "occurredAt": "2026-11-02T15:00:00.000Z", "precision": "second", "tz": "Asia/Tokyo", "source": "chat", "createdAt": "2026-11-02T15:00:00.000Z" },
      { "id": "ep-t3", "externalId": "x-t3", "sessionId": "s1", "seq": 2, "role": "user", "text": "last instant of the Tokyo day", "occurredAt": "2026-11-03T14:59:59.000Z", "precision": "second", "tz": "Asia/Tokyo", "source": "chat", "createdAt": "2026-11-03T14:59:59.000Z" },
      { "id": "ep-t4", "externalId": "x-t4", "sessionId": "s1", "seq": 3, "role": "user", "text": "first instant AFTER the Tokyo day ended", "occurredAt": "2026-11-03T15:00:00.000Z", "precision": "second", "tz": "Asia/Tokyo", "source": "chat", "createdAt": "2026-11-03T15:00:00.000Z" }
