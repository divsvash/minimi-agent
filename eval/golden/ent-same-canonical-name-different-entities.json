{
  "id": "ent-same-canonical-name-different-entities",
  "title": "Resolution: the same name on two entities is ambiguous, never a merge",
  "kind": "adversarial",
  "sut": "entity.resolve",
  "input": {
    "mode": "resolve",
    "entities": [
      {
        "id": "ent-atlas-a",
        "type": "product",
        "canonicalName": "Atlas",
        "aliases": [],
        "status": "active",
        "createdAt": "2026-11-01T00:00:00.000Z",
        "updatedAt": "2026-11-01T00:00:00.000Z"
      },
      {
        "id": "ent-atlas-b",
        "type": "product",
        "canonicalName": "Atlas",
        "aliases": [],
        "status": "active",
        "createdAt": "2026-11-01T00:00:00.000Z",
        "updatedAt": "2026-11-01T00:00:00.000Z"
      }
    ],
    "request": {
      "mention": { "name": "Atlas", "type": "product" },
