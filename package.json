{
  "name": "minimi",
  "version": "0.1.0",
  "private": true,
  "description": "Minimi — conversational agent with persistent, temporal, relational memory. Slice 1: memory spine + fenced job ledger.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d --wait neo4j",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/memory/migrate.ts",
    "memory:replay": "tsx src/jobs/replay.ts",
    "test": "tsx --test src/**/*.test.ts test/integration/*.test.ts",
    "test:unit": "tsx --test src/**/*.test.ts",
    "eval": "tsx src/eval/run.ts",
    "eval:bless": "tsx src/eval/run.ts --bless",
    "test:integration": "npm run db:up && tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "neo4j-driver": "^5.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
